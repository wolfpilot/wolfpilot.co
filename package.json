{
  "name": "wolfpilot.co",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "husky install",
    "dev": "concurrently -n NEXT,TS -c magenta,cyan \"next dev --webpack\" \"pnpm ts --watch\"",
    "build": "next build --webpack",
    "postbuild": "pnpm generate:sitemap",
    "start": "next start",
    "lint": "eslint src .storybook",
    "format": "prettier ./src/**/*.{ts,tsx} --write",
    "ts": "tsc --noEmit --incremental --preserveWatchOutput --pretty",
    "ts:watch": "pnpm ts --watch",
    "storybook": "storybook dev -p 6006 --ci",
    "build-storybook": "storybook build",
    "test": "jest --ci",
    "test:watch": "jest --watch",
    "test:coverage": "jest --ci --coverage --runInBand --watchAll=false",
    "generate:sitemap": "next-sitemap --config sitemap.config.js"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "image-size": "^2.0.4",
    "motion": "14.9.0",
    "next": "16.4.3",
    "next-seo": "^6.8.0",
    "next-sitemap": "^4.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-syntax-highlighter": "^15.6.6",
    "sharp": "0.35.5",
    "styled-components": "6.5.3",
    "use-next-navigation-event": "^0.1.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.5",
    "@storybook/nextjs": "10.6.5",
    "@storybook/react": "10.6.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "concurrently": "^9.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-storybook": "10.6.1",
    "eslint-plugin-testing-library": "7.16.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-extended": "^4.0.2",
    "lint-staged": "^15.5.2",
    "prettier": "3.9.10",
    "storybook": "10.6.5",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@12.11.2"
}
